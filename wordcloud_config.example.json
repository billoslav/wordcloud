{
  "wordcloud": {
    "width": 800,
    "height": 500,
    "font_path": "fonts/Arial Unicode.ttf",
    "min_font_size": 14,
    "max_font_size": 80,
    "font_step": 2,
    "max_words": 200,
    "min_word_length": 3,
    "margin": 2,
    "place_strategy": "random",
    "background_color": "white",
    "mode": "RGB",
    "black_white": false,
    "color_theme": null,
    "rect_only": false,
    "tracing_files": false,
    "mask_threshold": 200
  },
  "api": {
    "host": "127.0.0.1",
    "port": 5000,
    "max_job_age": 3600,
    "max_jobs": 100
  },
  "performance": {
    "enable_tracking": false,
    "tracking_detail": "basic",
    "cache": {
      "lru_max_size": 128,
      "lru_max_age_seconds": null,
      "disk_cache_dir": null,
      "disk_max_entries": 1000,
      "disk_max_size_bytes": 500000000,
      "disk_max_age_seconds": 604800,
      "disk_cleanup_interval_seconds": 600
    }
  },
  "output": {
    "default_format": "png",
    "results_folder": "Results",
    "dpi": 300
  }
}

